# ============================================
# Bitwarden Lite - Environment Configuration
# ============================================
# Copy this file to .env and configure for your environment
# See ENVIRONMENT_VARIABLES.md for detailed documentation

# ============================================
# CONFIGURATION VERSION
# ============================================
# Track configuration file version for easier updates and compatibility
CONFIG_VERSION=1.0.0

# ============================================
# BITWARDEN VERSION
# ============================================
# Bitwarden Lite Docker image version
# Use 'latest' for automatic updates or pin to specific version for stability
# Latest stable release: v2025.12.0 (as of December 16, 2025)
# Check available versions: https://github.com/bitwarden/self-host/releases
BW_VERSION=latest

# ============================================
# INSTANCE CONFIGURATION
# ============================================
# Unique name for this Bitwarden instance
# Used to prefix container names to avoid collisions
# Change this if running multiple instances on the same host
INSTANCE_NAME=bitwarden

# ============================================
# REQUIRED SETTINGS
# ============================================

# Domain where Bitwarden will be accessible (without http:// or https://)
BW_DOMAIN=localhost:8080

# Installation ID and Key from https://bitwarden.com/host/
# Required even for self-hosted instances
BW_INSTALLATION_ID=your-installation-id-here
BW_INSTALLATION_KEY=your-installation-key-here

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database provider: sqlite, postgresql, mysql, or sqlserver
BW_DB_PROVIDER=postgresql

# --- PostgreSQL Configuration (default) ---
BW_DB_SERVER=postgres
BW_DB_DATABASE=bitwarden_vault
BW_DB_USERNAME=bitwarden
BW_DB_PASSWORD=change_this_to_a_secure_password_min_32_chars
BW_DB_PORT=5432
POSTGRES_VERSION=16-alpine
POSTGRES_PASSWORD=change_this_to_a_secure_password_min_32_chars

# --- SQLite Configuration (alternative - simpler but less robust) ---
# Uncomment this line and comment PostgreSQL settings above to use SQLite
# BW_DB_PROVIDER=sqlite
# No additional configuration needed for SQLite
# Database file will be created at /etc/bitwarden/vault.db

# --- MySQL/MariaDB Configuration ---
# Uncomment and configure these if using MySQL/MariaDB
# BW_DB_PROVIDER=mysql
# BW_DB_SERVER=mysql
# BW_DB_DATABASE=bitwarden_vault
# BW_DB_USERNAME=bitwarden
# BW_DB_PASSWORD=change_this_to_a_secure_password_min_32_chars
# BW_DB_PORT=3306
# MYSQL_VERSION=8.0
# MYSQL_ROOT_PASSWORD=change_this_to_a_different_secure_password

# ============================================
# PORT CONFIGURATION
# ============================================
# HTTP port for Bitwarden container (mapped to host for nginx reverse proxy)
# Change this if port 8080 is already in use
BW_PORT_HTTP=8080

# HTTPS port (only needed if SSL is handled by Bitwarden container)
# Typically not used when behind nginx reverse proxy
# BW_PORT_HTTPS=8443

# ============================================
# SSL/TLS CONFIGURATION
# ============================================
# Enable SSL in Bitwarden container
# Set to false when using nginx reverse proxy (recommended)
BW_ENABLE_SSL=false

# SSL certificate files (only if BW_ENABLE_SSL=true)
# Files must be placed in the bitwarden-data volume
# BW_SSL_CERT=ssl.crt
# BW_SSL_KEY=ssl.key

# SSL with Certificate Authority
# BW_ENABLE_SSL_CA=false
# BW_SSL_CA_CERT=ca.crt

# SSL with Diffie-Hellman
# BW_ENABLE_SSL_DH=false
# BW_SSL_DH_CERT=dh.pem

# ============================================
# SERVICE CONFIGURATION
# ============================================
# Enable or disable Bitwarden services
# Disabling unused services can reduce memory usage

# Admin panel (DO NOT DISABLE - required for administration)
BW_ENABLE_ADMIN=true

# API service (DO NOT DISABLE - required for clients)
BW_ENABLE_API=true

# Identity service (DO NOT DISABLE - required for authentication)
BW_ENABLE_IDENTITY=true

# Website icons service
# Shows favicons for login items
BW_ENABLE_ICONS=true

# Icon proxy to cloud (reduces memory usage)
# If enabled, set BW_ENABLE_ICONS=false
# BW_ICONS_PROXY_TO_CLOUD=false

# Push notifications service
# Required for mobile push notifications and "Login with Device"
BW_ENABLE_NOTIFICATIONS=true

# Event logging (for Teams/Enterprise audit logs)
BW_ENABLE_EVENTS=false

# SSO service (Enterprise feature only)
BW_ENABLE_SSO=false

# SCIM service (Enterprise feature only)
BW_ENABLE_SCIM=false

# ============================================
# SMTP CONFIGURATION (Email)
# ============================================
# Required for password resets, verification emails, and invitations
# Leave commented out if you don't need email functionality

# Reply-to email address
# globalSettings__mail__replyToEmail=no-reply@example.com

# SMTP server settings
# globalSettings__mail__smtp__host=smtp.gmail.com
# globalSettings__mail__smtp__port=587
# globalSettings__mail__smtp__ssl=false
# globalSettings__mail__smtp__username=your-smtp-username
# globalSettings__mail__smtp__password=your-smtp-password

# ============================================
# SECURITY & ACCESS CONTROL
# ============================================

# Disable user registration (recommended after creating your account)
# Set to true to prevent unauthorized signups
# globalSettings__disableUserRegistration=false

# Admin email addresses (comma-separated)
# These users can access the /admin panel
# adminSettings__admins=admin@example.com

# Have I Been Pwned API key (for password breach checking)
# Get your key at: https://haveibeenpwned.com/API/Key
# globalSettings__hibpApiKey=your-hibp-api-key

# ============================================
# TWO-FACTOR AUTHENTICATION
# ============================================

# YubiKey support (requires Yubico API credentials)
# Get credentials at: https://upgrade.yubico.com/getapikey/
# globalSettings__yubico__clientId=your-yubico-client-id
# globalSettings__yubico__key=your-yubico-secret-key

# ============================================
# ADVANCED CONFIGURATION
# ============================================

# Real IP addresses (for accurate logging behind reverse proxy)
# Add your nginx server IP address here
# BW_REAL_IPS=192.168.1.1,10.0.0.1

# Content Security Policy (CSP)
# WARNING: Modifying this may break features
# Only change if you understand CSP implications
# BW_CSP=

# ============================================
# DOCKER RESOURCE LIMITS
# ============================================
# Uncomment to set memory limits for containers
# Bitwarden requires minimum 200MB
# BW_MEMORY_LIMIT=512m
# DB_MEMORY_LIMIT=256m

# ============================================
# NOTES
# ============================================
# 1. Never commit this .env file to version control
# 2. Use strong passwords (minimum 32 characters)
# 3. After initial setup, set globalSettings__disableUserRegistration=true
# 4. Keep your BW_INSTALLATION_ID and BW_INSTALLATION_KEY secure
# 5. Enable HTTPS on your nginx reverse proxy
# 6. Regularly backup your data volumes
# 7. Keep Docker and Bitwarden images updated
#
# For detailed documentation, see ENVIRONMENT_VARIABLES.md
# For nginx configuration examples, see README.md
